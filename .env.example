# Runtime
NODE_ENV=production

# Public URLs
PUBLIC_URL=https://app.example.com
API_URL=https://api.example.com

# PostgreSQL (external, e.g. Timmehosting)
DB_HOST=postgres.example.host
DB_PORT=5432
DB_NAME=rental_prod
DB_USER=rental_app
DB_PASSWORD=change_me
DB_SSLMODE=require
DATABASE_URL=postgres://rental_app:change_me@postgres.example.host:5432/rental_prod?sslmode=require

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change_me_long_random_value

# Payments
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mail / notifications
MAIL_FROM=no-reply@example.com
